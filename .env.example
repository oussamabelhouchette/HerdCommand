# Copy to .env (never commit secrets).

# --- Existing local Keycloak (already running) ---
KEYCLOAK_ISSUER=http://localhost:9090/realms/herdcommand

# Web client on that realm must allow:
#   Redirect URI: http://localhost:3000/api/auth/callback/keycloak
#   Web origin:   http://localhost:3000
#   Standard flow + PKCE

# --- Web (Next.js + Auth.js) ---
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-32-char-random-string
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=herdcommand
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:9090/realms/herdcommand
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- API (later) ---
API_PORT=8080
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:9090/realms/herdcommand
