# Copy to .env (never commit secrets).

# --- Existing local Keycloak (already running) ---
KEYCLOAK_ISSUER=http://localhost:9090/realms/herdcommand

# Web client on that realm must allow:
#   Redirect URI: http://localhost:3000/api/auth/callback/keycloak
#   Web origin:   http://localhost:3000
#   Standard flow + PKCE

# --- Web (Next.js + Auth.js) ---
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-32-char-random-string
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=herdcommand
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:9090/realms/herdcommand
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- API ---
# Local: same Postgres server as Keycloak, different database name.
# Keycloak -> keyclockDB   API -> herdcommand   user/password stay postgres/admin.
API_PORT=8080
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:9090/realms/herdcommand
DATABASE_URL=jdbc:postgresql://localhost:5432/herdcommand
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=admin

# Server-side Keycloak Admin API (PA-004). Never put this secret in React or git.
# Create confidential client herdcommand-admin with a service account, then:
# Realm management client roles: view-users, query-users, manage-users.
KEYCLOAK_ADMIN_BASE_URL=http://localhost:9090
KEYCLOAK_ADMIN_REALM=herdcommand
KEYCLOAK_ADMIN_CLIENT_ID=herdcommand-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_INVITE_REDIRECT_URI=http://localhost:3000/login
KEYCLOAK_INVITE_CLIENT_ID=herdcommand
KEYCLOAK_INVITE_LIFESPAN_SECONDS=43200
