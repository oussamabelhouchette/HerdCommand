{
  "name": "HerdCommand",
  "slug": "herdcommand",
  "scheme": "herdcommand",
  "version": "0.1.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "plugins": ["expo-router", "expo-secure-store"],
  "experiments": {
    "typedRoutes": true
  },
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.herdcommand.mobile"
  },
  "android": {
    "package": "com.herdcommand.mobile"
  },
  "extra": {
    "router": {
      "origin": false
    }
  }
}
