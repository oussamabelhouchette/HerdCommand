{
  "name": "herdcommand",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@herdcommand/web --filter=@herdcommand/mobile",
    "dev:web": "pnpm --filter @herdcommand/web dev",
    "dev:mobile": "pnpm --filter @herdcommand/mobile start",
    "build": "turbo run build --filter=@herdcommand/web --filter=@herdcommand/tokens",
    "lint": "turbo run lint --filter=@herdcommand/web --filter=@herdcommand/mobile --filter=@herdcommand/tokens",
    "test": "turbo run test --filter=@herdcommand/web --filter=@herdcommand/tokens",
    "api:dev": "mvn -f apps/api/pom.xml spring-boot:run",
    "api:test": "mvn -f apps/api/pom.xml test",
    "api:build": "mvn -f apps/api/pom.xml -DskipTests package"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2"
  }
}
