# Copy to the repo root as `.env` (local Compose) or `/opt/herdcommand/.env` (EC2).
# Never commit a filled copy — `.env` is gitignored.

# Browser origin, no trailing slash. Local default. EC2 bootstrap overwrites with http://PUBLIC_IP.
PUBLIC_ORIGIN=http://localhost

POSTGRES_USER=herdcommand
POSTGRES_PASSWORD=herdcommand
POSTGRES_DB=herdcommand

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Auth.js session encryption. Use a long random string on EC2 (bootstrap generates one).
AUTH_SECRET=change-me-to-a-32-char-random-string!!

# Confidential web client. Matches the test realm JSON (`web-dev-secret`).
AUTH_KEYCLOAK_SECRET=web-dev-secret

# Keycloak generates this on first import. Leave empty; bootstrap.sh fills it after Keycloak is up.
KEYCLOAK_ADMIN_CLIENT_SECRET=
